<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ptc\Embedded\ptc_z8.csv" LogicalName="Jsr4Z8.Core.Ptc.Embedded.ptc_z8.csv" />
    <EmbeddedResource Include="Dark\Embedded\dark_z8.csv" LogicalName="Jsr4Z8.Core.Dark.Embedded.dark_z8.csv" />
  </ItemGroup>
  <ItemGroup>
    <!-- Release backend payload pair generated by tools/pack-payload.
         payload.bin is ~500 MB and is never committed; the Exists conditions keep
         dev/test builds payload-free — PayloadManager's default ctor then throws a
         clear error instead of failing restore/build. When both files are present,
         csc embeds them regardless of size (non-resx EmbeddedResources are passed to
         the compiler as /resource, no size cap), with fixed LogicalNames so the
         runtime lookup never depends on file paths. -->
    <EmbeddedResource Include="Payload\Embedded\payload.bin" LogicalName="Jsr4Z8.Core.Payload.Embedded.payload.bin" Condition="Exists('Payload\Embedded\payload.bin')" />
    <EmbeddedResource Include="Payload\Embedded\payload.manifest.json" LogicalName="Jsr4Z8.Core.Payload.Embedded.payload.manifest.json" Condition="Exists('Payload\Embedded\payload.manifest.json')" />
  </ItemGroup>
  <ItemGroup>
    <!-- DngWriterTests exercises DngLjpegNative.lje_selftest (encoder sanity) -->
    <InternalsVisibleTo Include="Jsr4Z8.Tests" />
  </ItemGroup>
</Project>
