<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Dark"
             x:Class="Jsr4Z8.UI.App">
    <Application.Styles>
        <!-- Dark default; runtime Dark/Light/Default cycling lives in Services/ThemeService
             via Application.RequestedThemeVariant — SemiTheme 11.2.x has no variant property of its own.
             Locale=zh-CN switches Semi's built-in control strings to Chinese. -->
        <semi:SemiTheme Locale="zh-CN" />
    </Application.Styles>

    <!-- 字体统一：覆盖 Semi 的 DefaultFontFamily（Inter 打头+系统回退）为单一中文字族，
         中/英/数字同源同度量；窗口/弹层(ToolTip)经 DynamicResource 一并生效 -->
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="DefaultFontFamily">Microsoft YaHei UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
