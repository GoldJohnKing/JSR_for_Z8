<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>WinExe</OutputType>
    <Version>1.2.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jsr4Z8.Core\Jsr4Z8.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <!-- Pinned: 11.3.x is binary-incompatible with Avalonia 11.2.x -->
    <PackageReference Include="Semi.Avalonia" Version="11.2.1.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- QueueRunnerTests drive MainViewModel/QueueMediator internal seams -->
    <InternalsVisibleTo Include="Jsr4Z8.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Product identity marker for NativeExtractSweep: the single-file bundler only
         embeds PE-named files (assemblies / native libraries), so the marker rides as
         an 83-byte text file with a .dll name - never loaded, never a real PE, its
         NAME is the identity. Checked into the project (not libs\) so every publish
         carries it, dev builds included; the sweep claims .net\<exe>\<bundle-id>\
         caches that contain it, whatever file name or version the exe runs under. -->
    <None Include="jsr4z8.native-identity.dll" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native P/Invoke targets (build.bat Steps 2-3) plus the VC++ runtime DLLs
         they need (Step 3d: libraw.dll is linked /MD, and Windows ships no VC++
         redist) - all embedded into the single-file bundle at publish
         (IncludeNativeLibrariesForSelfExtract) and extracted to one directory,
         where the loader resolves libraw.dll's MSVCP140/VCRUNTIME140 imports. -->
    <None Include="..\..\libs\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
