<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Avalonia.Data.Converters"
             xmlns:vm="clr-namespace:Jsr4Z8.UI.ViewModels"
             xmlns:views="clr-namespace:Jsr4Z8.UI.Views"
             x:Class="Jsr4Z8.UI.Views.TaskCardView"
             x:DataType="vm:TaskGroupViewModel"
             x:CompileBindings="True">
    <!-- One task-group card (docs/design/card-states.html 六态). The root border carries
         the st-ready/st-running/st-done/st-failed/st-blocked class (maintained from
         code-behind on State changes) that colors the status pill and bottom state
         bar, plus st-droptarget
         while a NEF drag hovers an editable card (卡内拖放补齐). Chips are display+hover
         only; the per-chip ±EV/★/✕ mini buttons and the commands' own CanExecute carry
         the Ready/Blocked-only edit gating (非等曝光组用 ±EV 偏差胶囊替代★，点击设基准). -->
    <UserControl.Resources>
        <!-- Feather-style line icons (MIT), stroke rendered at usage site -->
        <StreamGeometry x:Key="Icon.Play">M5 3l14 9-14 9V3z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Stop">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z</StreamGeometry>
        <StreamGeometry x:Key="Icon.RotateCw">M23 4v6h-6M20.49 15a9 9 0 1 1-2.12-9.36L23 10</StreamGeometry>
        <StreamGeometry x:Key="Icon.External">M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3</StreamGeometry>
        <StreamGeometry x:Key="Icon.Trash">M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6</StreamGeometry>
        <StreamGeometry x:Key="Icon.FolderPlus">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2zM12 11v6M9 14h6</StreamGeometry>
        <StreamGeometry x:Key="Icon.Star">M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z</StreamGeometry>
        <StreamGeometry x:Key="Icon.X">M18 6 6 18M6 6l12 12</StreamGeometry>
        <StreamGeometry x:Key="Icon.Loader">M12 2v4M12 18v4M4.93 4.93l2.83 2.83M14.24 14.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M14.24 9.76l2.83-2.83</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 卡片根：Save_Z8 列表卡同款（Background1 + 描边 + 圆角 12 + 裁切） -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="StrokeThickness" Value="1.7" />
        </Style>

        <!-- 状态胶囊（五态纯展示，颜色由根 st-* 类驱动） -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 就绪：灰 -->
        <Style Selector="Border.card.st-ready Border.pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Border.card.st-ready Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="Border.card.st-ready TextBlock.pill-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <!-- 运行中：主色 + 呼吸点 -->
        <Style Selector="Border.card.st-running Border.pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="Border.card.st-running Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SemiColorPrimary}" />
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.card.st-running TextBlock.pill-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- 已完成：成功绿 -->
        <Style Selector="Border.card.st-done Border.pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorSuccessLight}" />
        </Style>
        <Style Selector="Border.card.st-done Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
        <Style Selector="Border.card.st-done TextBlock.pill-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- 失败：危险红 -->
        <Style Selector="Border.card.st-failed Border.pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
        </Style>
        <Style Selector="Border.card.st-failed Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Border.card.st-failed TextBlock.pill-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- 无法执行：警示橙 -->
        <Style Selector="Border.card.st-blocked Border.pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
        </Style>
        <Style Selector="Border.card.st-blocked Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SemiColorWarning}" />
        </Style>
        <Style Selector="Border.card.st-blocked TextBlock.pill-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- 文件芯片：基准=主色底白字带实心★，其余 Fill0 空心★；本体仅展示+悬浮，
             换基准/移除走芯片内迷你按钮 -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <Style Selector="Border.chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Border.chip.reference">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <Style Selector="Border.chip.reference TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 芯片内迷你动作按钮（★设基准 / ✕移除）：行尾动作的芯片内微缩版，透明扁平常显 -->
        <Style Selector="Button.chip-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- 悬停仅做底色提亮（芯片自身悬停已是 Fill1，这里用 Fill2 保对比） -->
        <Style Selector="Button.chip-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <Style Selector="Button.chip-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <!-- EV 胶囊自带底色，悬停不加外圈（chip-action 的 Fill2 悬停底会从胶囊外露出，形似浮动边框——仅 chip-ev 置透明；★/✕ 图标钮保留悬停反馈） -->
        <Style Selector="Button.chip-ev:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip-ev:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- EV 胶囊本体悬停/按下反馈：非基准 Fill1→Fill2/主色浅底；基准黄底胶囊悬停保持黄色
             （黄底样式声明在后、悬停时两者皆匹配→后者胜=基准态恒黄，其高亮即当前基准标识） -->
        <Style Selector="Button.chip-ev:pointerover Border.ev-pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <Style Selector="Button.chip-ev:pressed Border.ev-pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="Button.chip-ev:pointerover:pressed Border.ev-pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <!-- ★：非基准=Text3 空心；基准=#F0A020 实心（Blocked 橙警告色系一致） -->
        <Style Selector="Button.chip-action Path.star-icon">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorText3}" />
            <Setter Property="StrokeThickness" Value="1.7" />
        </Style>
        <Style Selector="Button.chip-action.reference Path.star-icon">
            <Setter Property="Fill" Value="#F0A020" />
            <Setter Property="Stroke" Value="#F0A020" />
        </Style>
        <Style Selector="Button.chip-star">
            <Setter Property="ToolTip.Tip" Value="设为基准帧" />
        </Style>
        <Style Selector="Button.chip-star.reference">
            <Setter Property="ToolTip.Tip" Value="当前基准帧" />
        </Style>
        <!-- ✕：Text3 常态，悬停转危险色（row-action-danger 同式）；基准胶囊里用白 -->
        <Style Selector="Button.chip-action Path.x-icon">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorText3}" />
            <Setter Property="StrokeThickness" Value="1.7" />
        </Style>
        <Style Selector="Border.chip.reference Path.x-icon">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.chip-action:pointerover Path.x-icon">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorDanger}" />
        </Style>

        <!-- ±EV 偏差胶囊（F3，非等曝光组替代★）：整颗芯片一体 [±EV 小胶囊|文件名|✕]，
             点击胶囊设该帧为基准；非基准胶囊独立底色 Fill1/Text1，基准帧胶囊换基准★
             同款黄底 #F0A020 + 深字 #262626 高亮（与星标基准态同一视觉语言，固定深色
             字在黄底上明暗两主题均可读） -->
        <Style Selector="Border.ev-pill">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style Selector="Border.ev-pill TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <!-- 基准帧的 EV 胶囊：基准★同款黄底高亮（在基础 ev-pill 样式之后声明，
             同属性后者覆盖 → 黄底必胜 Fill1 底色） -->
        <Style Selector="Button.chip-ev.reference Border.ev-pill">
            <Setter Property="Background" Value="#F0A020" />
        </Style>
        <Style Selector="Button.chip-ev.reference Border.ev-pill TextBlock">
            <Setter Property="Foreground" Value="#262626" />
        </Style>

        <!-- 拖放悬停高亮（卡内补齐）：主色描边 + 主色浅底 -->
        <Style Selector="Border.card.st-droptarget">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 贴卡底 4px 状态条：填充色随卡状态（色键同 MainWindow 统计条圆点）；
             Semi 模板的 PART_Indicator Background 即 TemplateBinding Foreground，
             st-running 不覆盖（Semi 默认主色表运行中进度） -->
        <Style Selector="Border.card.st-ready ProgressBar.state-bar">
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="Border.card.st-done ProgressBar.state-bar">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
        <Style Selector="Border.card.st-failed ProgressBar.state-bar">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Border.card.st-blocked ProgressBar.state-bar">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
        </Style>

        <!-- 校验/运行错误条 -->
        <Style Selector="Border.msg">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="Border.msg TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 校验中 Loading 覆盖层（F4）：半透明遮罩盖住整卡（后绘子元素置顶），可命中
             （默认）→ 遮罩期间卡上编辑入口被实际阻断；居中旋转 loader 图标 + 校验中 -->
        <Style Selector="Border.validating-overlay">
            <Setter Property="Background" Value="{DynamicResource SemiColorOverlayBackground}" />
        </Style>
        <!-- feather Loader 图标自转：0.8s/圈无限循环，绕自身中心 -->
        <Style Selector="Path.spin">
            <Setter Property="RenderTransformOrigin" Value="50%, 50%" />
            <Setter Property="RenderTransform">
                <RotateTransform />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.validating-overlay TextBlock.loading-text">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
    </UserControl.Styles>

    <!-- 卡根同时是拖放目标（卡内补齐）：含 NEF 且可编辑时 Copy+高亮；Drop 先吞再补齐，
         避免冒泡到窗口级新建组（路由事件在 code-behind AddHandler 接线）。
         内容 Grid 双层：主 StackPanel + 校验中 Loading 覆盖层（后绘置顶，F4） -->
    <Border x:Name="Root" Classes="card" ClipToBounds="True" DragDrop.AllowDrop="True">
        <Grid>
        <StackPanel>
            <!-- 头行：基准帧名 + 状态胶囊 + 动作（按状态由 CanExecute 自动启停） -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,12,14,10">
                <TextBlock Text="{Binding ReferenceName, StringFormat='基准 {0}'}"
                           FontSize="13.5" FontWeight="SemiBold" MaxWidth="240"
                           Foreground="{DynamicResource SemiColorText0}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReferenceName}" />
                <Border Grid.Column="1" Classes="pill" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="dot" />
                        <TextBlock Classes="pill-text" Text="{Binding StateText}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Small" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.Play}" />
                            </Viewbox>
                            <TextBlock Text="开始" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Small" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.Stop}" />
                            </Viewbox>
                            <TextBlock Text="停止" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Small" Command="{Binding RetryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.RotateCw}" />
                            </Viewbox>
                            <TextBlock Text="重试" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Small" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.External}" />
                            </Viewbox>
                            <TextBlock Text="打开" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Small" Click="OnAddRawFiles" IsVisible="{Binding IsEditable}"
                            ToolTip.Tip="向本组补齐 RAW 帧">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.FolderPlus}" />
                            </Viewbox>
                            <TextBlock Text="添加 RAW" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Small" Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="13" Height="13">
                                <Path Classes="icon" Data="{StaticResource Icon.Trash}" />
                            </Viewbox>
                            <TextBlock Text="移除" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 芯片行：非等曝光组 ±EV 偏差胶囊（点击设基准）/等曝光组★设基准 + 文件名悬浮参数
                 + ✕移除（仅 Ready/Blocked 可编辑）；胶囊与★互斥由卡级 IsBracketed 驱动 -->
            <ItemsControl x:Name="ChipsHost" ItemsSource="{Binding FrameChips}" Margin="14,2,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FrameChipViewModel">
                        <Border Classes="chip" Classes.reference="{Binding IsReference}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <!-- 非等曝光组：±EV 偏差胶囊（点击胶囊设基准，基准帧黄底高亮） -->
                                <Button Classes="chip-action chip-ev" Classes.reference="{Binding IsReference}"
                                        Command="{ReflectionBinding $parent[views:TaskCardView].DataContext.SetReferenceCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{ReflectionBinding $parent[views:TaskCardView].DataContext.IsBracketed}"
                                        ToolTip.Tip="设为基准帧（点击此标签）">
                                    <Border Classes="ev-pill">
                                        <TextBlock Text="{Binding EvText}" />
                                    </Border>
                                </Button>
                                <!-- 等曝光组：★设基准（原行为不变） -->
                                <Button Classes="chip-action chip-star" Classes.reference="{Binding IsReference}"
                                        Command="{ReflectionBinding $parent[views:TaskCardView].DataContext.SetReferenceCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{ReflectionBinding !$parent[views:TaskCardView].DataContext.IsBracketed}">
                                    <Viewbox Width="12" Height="12">
                                        <Path Classes="star-icon" Data="{StaticResource Icon.Star}" />
                                    </Viewbox>
                                </Button>
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                           MaxWidth="160" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding InfoText}" />
                                <Button Classes="chip-action chip-x" ToolTip.Tip="移除此帧"
                                        Command="{ReflectionBinding $parent[views:TaskCardView].DataContext.RemoveFileCommand}"
                                        CommandParameter="{Binding}">
                                    <Viewbox Width="12" Height="12">
                                        <Path Classes="x-icon" Data="{StaticResource Icon.X}" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 元信息行：待输出/已输出文件名 -->
            <TextBlock Text="{Binding MetaText}" FontSize="11.5"
                       Foreground="{DynamicResource SemiColorText2}"
                       Margin="14,6,14,8" TextWrapping="Wrap"
                       IsVisible="{Binding MetaText, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />

            <!-- 校验失败/ 运行失败错误条 -->
            <Border Classes="msg" Margin="14,6,14,10"
                    IsVisible="{Binding IssuesText, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding IssuesText}" />
            </Border>
            <Border Classes="msg" Margin="14,6,14,10"
                    IsVisible="{Binding ErrorText, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorText}" />
            </Border>

            <!-- 贴卡底的 4px 状态条（恒可见）：运行中=进度，其余态满宽状态色（上方样式） -->
            <ProgressBar Classes="state-bar"
                         Minimum="0" Maximum="100" Value="{Binding BarValue}"
                         Height="4" MinHeight="4" CornerRadius="0" Padding="0" />
        </StackPanel>

        <!-- 校验中 Loading 覆盖层（F4）：IsValidating 期间盖住整卡（含头部按钮/芯片，
             可命中 → 交互被实际阻断），居中旋转 loader + 校验中文字 -->
        <Border Classes="validating-overlay" IsVisible="{Binding IsValidating}">
            <StackPanel Orientation="Horizontal" Spacing="9"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                    <Path Classes="icon spin" Data="{StaticResource Icon.Loader}" />
                </Viewbox>
                <TextBlock Classes="loading-text" Text="校验中" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>
    </Border>
</UserControl>
