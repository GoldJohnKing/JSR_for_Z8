<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="120"
             x:Class="Jsr4Z8.UI.Views.LogPanel"
             x:Name="Root">
    <!-- 只读卡内日志（Task 13）：滚动视口有上限高度，贴底时自动跟随新行（用户上滚即钉住）；
         展开仍由卡片的 ▾日志 开关控制，本面板不提供任何折叠 UI。
         修复（发布后）：Lines 的 ItemsSource 之前从未接线（代码后置只接了自动滚动，
         日志面板因此始终为空）—— 现在直接绑定到本控件自己的 LogLines 样式属性（卡片
         通过该属性喂数据）；ItemsPanel 换 VirtualizingStackPanel，一次运行 1.6 万行
         日志不再全部实例化（水平滚动禁用是垂直虚拟化的宽度约束前提）。 -->
    <ScrollViewer x:Name="Scroller" MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Lines" ItemsSource="{Binding LogLines, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
