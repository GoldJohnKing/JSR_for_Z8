<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Jsr4Z8.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="470"
        x:Class="Jsr4Z8.UI.Views.NewTaskDialog"
        x:DataType="vm:NewTaskViewModel"
        x:CompileBindings="True"
        Title="新建任务组"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 「新建任务组」v3 · A 风格芯片 + 黑场按钮 (docs/design/add-task-flow-v3.html).
         ALL logic lives in NewTaskViewModel; this view only binds and wires interaction
         (drag-drop, click-to-pick, dark picker, closing) in the code-behind. -->
    <Window.Styles>
        <!-- 投放区：Border 不支持虚线，用描边 Rectangle 模拟 -->
        <Style Selector="Rectangle.dropdash">
            <Setter Property="Stroke" Value="#667D9BFF" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="7,7" />
        </Style>
        <Style Selector="Grid.dropzone">
            <Setter Property="Margin" Value="18,16,18,6" />
            <Setter Property="MinHeight" Value="88" />
        </Style>
        <Style Selector="TextBlock.drophint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#7D9BFF" />
        </Style>
        <Style Selector="TextBlock.dropsub">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 帧芯片：基准蓝底白字，其余灰，不可读红 -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#26808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText}" />
        </Style>
        <Style Selector="Border.chip.reference">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <Style Selector="Border.chip.reference TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- error 在 reference 之后声明：不可读的基准芯片红色优先 -->
        <Style Selector="Border.chip.error">
            <Setter Property="Background" Value="#33E5484D" />
            <Setter Property="BorderBrush" Value="#80E5484D" />
        </Style>
        <Style Selector="Border.chip.error TextBlock">
            <Setter Property="Foreground" Value="#FF6369" />
        </Style>
        <Style Selector="Button.xbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText}" />
        </Style>
        <!-- 黑场行：空 = 虚线暖橙选择按钮；已选 = 实心行 + Z8·ISO·快门 标签 + 更换… -->
        <Style Selector="Rectangle.darkdash">
            <Setter Property="Stroke" Value="#66FFB020" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="6,6" />
        </Style>
        <Style Selector="Border.darkrow">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground}" />
        </Style>
        <Style Selector="Border.darktag">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#26808080" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.darktag TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FFB020" />
        </Style>
        <!-- 校验行：绿 ✓ / 红问题 -->
        <Style Selector="TextBlock.ok">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#4CC38A" />
            <Setter Property="Margin" Value="20,8,20,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.msg">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="18,8,18,0" />
            <Setter Property="Background" Value="#26E5484D" />
        </Style>
        <Style Selector="Border.msg TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF6369" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <StackPanel>
        <!-- 阶段一空提示 / 阶段二芯片墙：拖放 + 点击选择（代码后置接线） -->
        <Grid x:Name="DropZone" Classes="dropzone" DragDrop.AllowDrop="True"
              PointerPressed="OnDropZonePointerPressed">
            <Rectangle Classes="dropdash" RadiusX="10" RadiusY="10" />
            <Grid Margin="10,6" VerticalAlignment="Center">
                <StackPanel IsVisible="{Binding HasNoFrames}" Spacing="5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="drophint" Text="⬇ 拖入 7 张 RAW，或点击选择" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasFrames}" Spacing="7">
                    <ItemsControl ItemsSource="{Binding Frames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrameChipVm">
                                <Border Classes="chip" Classes.reference="{Binding IsReference}"
                                        Classes.error="{Binding IsError}"
                                        PointerPressed="OnChipPointerPressed"
                                        ToolTip.Tip="点击设为基准帧">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="★基准" IsVisible="{Binding IsReference}" />
                                        <TextBlock Text="{Binding FileName}" />
                                        <Button Classes="xbtn" Content="✕" ToolTip.Tip="移除此帧"
                                                Command="{Binding Remove}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dropsub"
                               Text="按文件名排序 · 点击标签设为基准 · × 移除 · 可继续拖入补齐/替换" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 黑场：空 = 虚线按钮（📂 选择黑场文件…），已选 = 实心行（文件名 + Z8·ISO·快门 + 更换…） -->
        <Grid Margin="18,10,18,0" MinHeight="36">
            <Grid IsVisible="{Binding HasNoDark}" PointerPressed="OnDarkRowPointerPressed">
                <Rectangle Classes="darkdash" RadiusX="8" RadiusY="8" />
                <StackPanel Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📂" FontSize="13" />
                    <TextBlock Text="选择黑场文件…" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFB020" />
                </StackPanel>
            </Grid>
            <Border Classes="darkrow" IsVisible="{Binding HasDark}" PointerPressed="OnDarkRowPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕯 黑场" FontSize="12" Opacity="0.85" />
                        <TextBlock Text="{Binding DarkName}" FontSize="12" FontWeight="SemiBold"
                                   Margin="6,0,0,0" />
                        <Border Classes="darktag"
                                IsVisible="{Binding DarkInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding DarkInfoText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="更换…" FontSize="12"
                               Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- 校验行：绿 ✓（通过）或红问题（含文件名） -->
        <TextBlock Classes="ok" Text="{Binding State.PtcInfoText}"
                   IsVisible="{Binding State.PtcInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Classes="msg"
                IsVisible="{Binding State.IssuesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding State.IssuesText}" />
        </Border>

        <!-- 页脚：取消 + 创建任务组（CanRun 前禁用） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                    Margin="18,16,18,16">
            <Button Content="取消" MinWidth="84" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="创建任务组" MinWidth="104" Command="{Binding CreateCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
